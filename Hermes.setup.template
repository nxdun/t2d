  try{let r=await fetch("/onboard-api/configure",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({provider:currentProvider,model:$("model").value==="__custom"?$("customModel").value.trim():$("model").value,apiKey:$("apiKey").value})}),d=await r.json();if(!r.ok)throw Error(d.error||"Setup failed");$("apiKey").value="";$("pill").textContent="Configured";setMsg($("providerMsg"),`Hermes is configured for ${d.providerLabel} / ${d.model}.`,"msg ok");$("dashboard").href=d.dashboardUrl||"/chat";$("dashboard").style.display="inline-flex"}catch(err){setMsg($("providerMsg"),err.message||String(err),"msg err")}finally{$("saveProvider").disabled=false}
};
async function status(){try{let r=await fetch("/onboard-status"),d=await r.json();if(d.configured){currentProvider=d.provider||"nvidia";$("pill").textContent=`Configured: ${d.providerLabel}`;setMsg($("providerMsg"),`Hermes already has a key for ${d.providerLabel} / ${d.model}.`,"msg ok");$("dashboard").style.display="inline-flex"}else $("pill").textContent="Setup required"}catch(e){$("pill").textContent="Setup required"}renderProvider()}
status();
</script></body></html>
"""


def render_html():
    return HTML_TEMPLATE.replace("__PROVIDERS__", json.dumps(public_providers()))


class Handler(BaseHTTPRequestHandler):
    server_version = "HermesLaunchableOnboard/1.0"

    def log_message(self, fmt, *args):
        print(f"{self.address_string()} - {fmt % args}", flush=True)

    def send_json(self, status, payload):
        body = json.dumps(payload).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def send_html(self, body):
        raw = body.encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(raw)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(raw)

    def do_GET(self):
        path = urlparse(self.path).path
        if path == "/onboard-auth":
            if configured_state()["configured"]:
                self.send_response(204)
                self.send_header("Cache-Control", "no-store")
                self.end_headers()
            else:
                self.send_response(401)
                self.send_header("Cache-Control", "no-store")
                self.end_headers()
            return
        if path in {"/onboard", "/onboard/"}:
            self.send_html(render_html())
            return
        if path == "/onboard-status":
            self.send_json(200, configured_state())
            return
        if path == "/onboard-health":
            state = configured_state()
            self.send_json(200, {"ok": True, "configured": state["configured"]})
            return
        self.send_response(404)
        self.end_headers()

    def do_POST(self):
        path = urlparse(self.path).path
        if path != "/onboard-api/configure":
            self.send_response(404)
            self.end_headers()
            return
        try:
            length = min(int(self.headers.get("Content-Length", "0") or "0"), 65536)
            body = self.rfile.read(length).decode("utf-8")
            payload = json.loads(body or "{}")
        except Exception:
            self.send_json(400, {"error": "Send a valid JSON request."})
            return
        validated, error = validate_payload(payload)
        if error:
            self.send_json(400, {"error": error})
            return
        ok, output = run_configure(validated)
        if not ok:
            self.send_json(500, {"error": output})
            return
        provider_cfg = PROVIDERS[validated["provider"]]
        self.send_json(
            200,
            {
                "ok": True,
                "provider": validated["provider"],
                "providerLabel": provider_cfg["label"],
                "model": validated["model"],
                "dashboardUrl": "/chat",
            },
        )


if __name__ == "__main__":
    server = ThreadingHTTPServer((ONBOARD_HOST, ONBOARD_PORT), Handler)
    print(f"Hermes onboarding server listening on http://{ONBOARD_HOST}:{ONBOARD_PORT}", flush=True)
    server.serve_forever()
