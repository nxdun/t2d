  systemctl daemon-reload
  systemctl enable --now hermes-dashboard.service
  systemctl restart hermes-dashboard.service
}

install_nginx_proxy() {
  rm -f /etc/nginx/sites-enabled/default
  cat > /etc/nginx/sites-available/hermes-launchable <<NGINX
map \$http_upgrade \$connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen ${PUBLIC_DASHBOARD_HOST}:${PUBLIC_DASHBOARD_PORT} default_server;
    server_name _;
    absolute_redirect off;
    port_in_redirect off;

    location = /onboard-auth {
        internal;
        proxy_pass http://${ONBOARD_HOST}:${ONBOARD_PORT}/onboard-auth;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI \$request_uri;
    }

    location /onboard-api/ {
        proxy_pass http://${ONBOARD_HOST}:${ONBOARD_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_buffering off;
    }

    location = /onboard {
        proxy_pass http://${ONBOARD_HOST}:${ONBOARD_PORT}/onboard;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_buffering off;
    }

    location = /onboard/ {
        proxy_pass http://${ONBOARD_HOST}:${ONBOARD_PORT}/onboard;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_buffering off;
    }

    location = /onboard-status {
        proxy_pass http://${ONBOARD_HOST}:${ONBOARD_PORT}/onboard-status;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_buffering off;
    }

    location = /onboard-health {
        proxy_pass http://${ONBOARD_HOST}:${ONBOARD_PORT}/onboard-health;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_buffering off;
    }

    location @onboard_redirect {
        return 302 /onboard;
    }

    location / {
        auth_request /onboard-auth;
        error_page 401 = @onboard_redirect;

        proxy_pass http://${DASHBOARD_HOST}:${DASHBOARD_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection \$connection_upgrade;
        proxy_set_header Host ${DASHBOARD_HOST}:${DASHBOARD_PORT};
        proxy_set_header Origin http://${DASHBOARD_HOST}:${DASHBOARD_PORT};
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_buffering off;
        proxy_cache off;
    }
}
NGINX

  ln -sf /etc/nginx/sites-available/hermes-launchable /etc/nginx/sites-enabled/hermes-launchable
  nginx -t
  systemctl enable --now nginx
  systemctl restart nginx
}

configure_default_model() {
  if [[ -f "${STATE_DIR}/default-model-written" && "${HERMES_FORCE_DEFAULT_MODEL:-0}" != "1" ]]; then
    echo "Default model was already written; leaving existing Hermes model config in place."
    return
  fi

  echo "Setting first-run default provider to ${DEFAULT_PROVIDER} (${DEFAULT_MODEL})..."
  run_as_user /usr/local/bin/hermes-brev-quickstart \
    --provider "${DEFAULT_PROVIDER}" \
    --model "${DEFAULT_MODEL}" \
    --no-key
  touch "${STATE_DIR}/default-model-written"
}

wait_for_dashboard() {
  echo "Waiting for Hermes onboarding proxy readiness..."
  for _ in $(seq 1 180); do
    if curl -fsS --max-time 2 "http://${DASHBOARD_HEALTH_HOST}:${PUBLIC_DASHBOARD_PORT}/onboard-health" >/dev/null 2>&1; then
      date -Is > "${STATE_DIR}/ready"
      echo "Hermes onboarding proxy is ready."
      return 0
    fi
    sleep 2
  done

  echo "Hermes onboarding proxy did not become ready in time." >&2
  systemctl --no-pager --full status hermes-dashboard.service || true
  systemctl --no-pager --full status hermes-onboarding.service || true
  systemctl --no-pager --full status nginx || true
  exit 1
}

install_hermes
install_quickstart
install_messaging_walkthrough
configure_default_model
write_launchable_readme
install_dashboard_service
install_onboarding_gate
install_nginx_proxy
wait_for_dashboard

echo "Hermes Launchable setup complete."
echo "Readme: ${USER_HOME}/HERMES-LAUNCHABLE.md"
echo "Onboarding health: http://${DASHBOARD_HEALTH_HOST}:${PUBLIC_DASHBOARD_PORT}/onboard-health"
