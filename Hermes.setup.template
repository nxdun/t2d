</style></head><body><main><header><div><h1>HERMES</h1><p>Configure a model provider before opening the dashboard.</p></div><div id="pill" class="pill">Checking setup</div></header><section><h2>Model provider</h2><form id="providerForm"><label for="provider">Provider</label><select id="provider"></select><label for="model">Model</label><select id="model"></select><input id="customModel" autocomplete="off" spellcheck="false" style="display:none;margin-top:10px"><label id="keyLabel" for="apiKey">API key</label><input id="apiKey" type="password" autocomplete="off" spellcheck="false"><p class="help"><a id="keyHelp" href="#" target="_blank" rel="noreferrer">Get provider key</a></p><button id="saveProvider" type="submit">CONFIGURE HERMES</button><div id="providerMsg" class="msg"></div><a id="dashboard" class="secondary" href="/chat" style="display:none">OPEN HERMES DASHBOARD</a></form></section></main><script>
const P=__PROVIDERS__,$=id=>document.getElementById(id);
let currentProvider="nvidia";
function provider(){return P.find(x=>x.id===currentProvider)||P[0]}
function fillSelect(el,items,label){el.innerHTML="";items.forEach(x=>{let o=document.createElement("option");o.value=x.id||x;o.textContent=label?label(x):x;el.appendChild(o)})}
function setMsg(el,text,cls="msg"){el.className=cls;el.textContent=text||""}
function renderProvider(){
  fillSelect($("provider"),P,x=>x.id==="nvidia"?`${x.label} (Default)`:x.label);$("provider").value=currentProvider;
  let p=provider();$("keyLabel").textContent=p.keyLabel;$("apiKey").placeholder=p.keyPlaceholder;$("keyHelp").href=p.keyHelpUrl;
  $("model").innerHTML="";p.models.concat(["Other model ID"]).forEach(x=>{let o=document.createElement("option");o.value=x==="Other model ID"?"__custom":x;o.textContent=x;$("model").appendChild(o)});$("model").value=p.defaultModel;$("customModel").placeholder=p.defaultModel;$("customModel").style.display="none";
}
$("provider").onchange=e=>{currentProvider=e.target.value;renderProvider()};
$("model").onchange=()=>{$("customModel").style.display=$("model").value==="__custom"?"block":"none"};
$("providerForm").onsubmit=async e=>{
